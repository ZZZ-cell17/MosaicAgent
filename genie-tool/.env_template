# MosaicAgent server
SERVER_BASE_URL=http://127.0.0.1:1601
LOG_PATH=./logs/server.log
API_TIMEOUT=300
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MRAG_MAX_ROUNDS=3
MRAG_MAX_SUBQUERIES=3
MRAG_MAX_TEXT_CONTEXTS=8
MRAG_MAX_VISUAL_CONTEXTS=1
MRAG_SUMMARY_MAX_CHUNKS=8
DEFAULT_KB_ID=mosaic-demo

# Text generation model (OpenAI-compatible API)
LLM_API_KEY=
LLM_MODEL_BASE_URL=
LLM_MODEL_NAME=
LLM_SEND_THINKING_OPTIONS=true

# Vision-language model (OpenAI-compatible API)
VLM_API_KEY=
VLM_MODEL_BASE_URL=
VLM_MODEL_NAME=
VLM_SEND_THINKING_OPTIONS=true

# Text embedding model (OpenAI-compatible API)
TEXT_EMBEDDING_TYPE=openai
TEXT_EMBEDDING_BASE_URL=
TEXT_EMBEDDING_API_KEY=
TEXT_EMBEDDING_MODEL_NAME=
TEXT_EMBEDDING_MAX_TEXT_LENGTH=8000
TEXT_EMBEDDING_DIMENSION=1024

# Multimodal embedding model (DashScope)
IMAGE_EMBEDDING_TYPE=dashscope
DASHSCOPE_MULTIMODAL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/multimodal-embedding/multimodal-embedding
DASHSCOPE_MULTIMODAL_EMBEDDING_MODEL_NAME=qwen2.5-vl-embedding
DASHSCOPE_API_KEY=
IMAGE_EMBEDDING_DIMENSION=1024

# OCR: vlm-ocr reuses the VLM settings above
OCR_TYPE=vlm-ocr
DEEPSEEK_OCR_BASE_URL=
DEEPSEEK_OCR_API_KEY=
DEEPSEEK_OCR_MODEL_NAME=

# Text reranker
TEXT_RERANKER_TYPE=api
TEXT_RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
TEXT_RERANKER_API_KEY=
TEXT_RERANKER_MODEL_NAME=qwen3-rerank
RERANK_SCORE_THRESHOLD=0.3

# Document splitting and PDF parsing
CHUNK_TYPE=markdown
CHUNK_SIZE=500
CHUNK_OVERLAP=100
ENABLE_SUB_CHUNK_ENHANCE=true
SUB_CHUNK_SIZE=100
SMALL_PDF_PAGE_THRESHOLD=10
PDF_CHUNK_SIZE=4
ENABLE_MINERU=false
MINERU_BASE_URL=https://mineru.net/api/v4/extract/task
MINERU_API_KEY=

# Retrieval
RETRIEVAL_TEXT_THRESHOLD=0.7
RETRIEVAL_IMAGE_THRESHOLD=0.6
RETRIEVAL_PAGE_THRESHOLD=0.35
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_SYMLINKS_WARNING=1
FASTEMBED_CACHE_PATH=./data/fastembed

# Server-side remote access is disabled unless explicitly enabled and allowlisted
MAX_REMOTE_FILE_SIZE=52428800
ENABLE_REMOTE_FILE_IMPORT=false
REMOTE_FILE_ALLOWED_HOSTS=
ENABLE_WEB_IMPORT=false
WEB_IMPORT_ALLOWED_HOSTS=
QUERY_IMAGE_ALLOWED_HOSTS=
ENABLE_MARKDOWN_REMOTE_IMAGES=false
MARKDOWN_IMAGE_ALLOWED_HOSTS=
MAX_REMOTE_IMAGE_SIZE=10485760

# Metadata and local file storage
STORE_TYPE=sqlite
SQLITE_PATH=./data/mrag.sqlite3
LOCAL_STORAGE_PATH=./data/files

# Vector database
VECTOR_STORE_TYPE=qdrant
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
# The following values are used only when QDRANT_MODE=server
QDRANT_URL=http://127.0.0.1:6333
QDRANT_PORT=6334
QDRANT_API_KEY=
TEXT_COLLECTION=mosaic_mrag_text_vectors
IMAGE_COLLECTION=mosaic_mrag_image_vectors
PAGE_COLLECTION=mosaic_mrag_page_vectors

# Optional S3-compatible storage, used by MinerU URL submission
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
OSS_SERVER_BASE_URL=http://127.0.0.1:1601/v1/storage
